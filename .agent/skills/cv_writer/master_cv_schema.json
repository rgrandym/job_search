{
  "$defs": {
    "Basics": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Current or target professional title",
          "title": "Headline"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City, Country",
          "title": "Location"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "name"
      ],
      "title": "Basics",
      "type": "object"
    },
    "Bullet": {
      "additionalProperties": false,
      "description": "One accomplishment. `id` is stable and used for provenance when tailoring.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_\\-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "skills": {
          "description": "Skills evidenced by this bullet",
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "metrics": {
          "description": "Verifiable quantities, e.g. '40%', '$2M', '12 engineers'",
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Bullet",
      "type": "object"
    },
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "name"
      ],
      "title": "Certification",
      "type": "object"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "institution": {
          "title": "Institution",
          "type": "string"
        },
        "degree": {
          "title": "Degree",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "institution",
        "degree"
      ],
      "title": "Education",
      "type": "object"
    },
    "Experience": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_\\-]+$",
          "title": "Id",
          "type": "string"
        },
        "company": {
          "title": "Company",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "start": {
          "description": "YYYY-MM",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM, or null if current",
          "title": "End"
        },
        "bullets": {
          "items": {
            "$ref": "#/$defs/Bullet"
          },
          "title": "Bullets",
          "type": "array"
        }
      },
      "required": [
        "id",
        "company",
        "title",
        "start"
      ],
      "title": "Experience",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "Link",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "description": "Job-search preferences. Used by the matcher, never printed on the CV.",
      "properties": {
        "target_titles": {
          "items": {
            "type": "string"
          },
          "title": "Target Titles",
          "type": "array"
        },
        "locations": {
          "items": {
            "type": "string"
          },
          "title": "Locations",
          "type": "array"
        },
        "work_arrangements": {
          "items": {
            "enum": [
              "remote",
              "hybrid",
              "onsite"
            ],
            "type": "string"
          },
          "title": "Work Arrangements",
          "type": "array"
        },
        "willing_to_relocate": {
          "default": false,
          "title": "Willing To Relocate",
          "type": "boolean"
        },
        "min_salary": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum acceptable annual salary",
          "title": "Min Salary"
        }
      },
      "title": "Preferences",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_\\-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "Project",
      "type": "object"
    },
    "SkillGroup": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "category",
        "items"
      ],
      "title": "SkillGroup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The complete, factual career record. All tailored CVs derive from it.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "basics": {
      "$ref": "#/$defs/Basics"
    },
    "experience": {
      "items": {
        "$ref": "#/$defs/Experience"
      },
      "title": "Experience",
      "type": "array"
    },
    "education": {
      "items": {
        "$ref": "#/$defs/Education"
      },
      "title": "Education",
      "type": "array"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillGroup"
      },
      "title": "Skills",
      "type": "array"
    },
    "certifications": {
      "items": {
        "$ref": "#/$defs/Certification"
      },
      "title": "Certifications",
      "type": "array"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "title": "Languages",
      "type": "array"
    },
    "preferences": {
      "$ref": "#/$defs/Preferences"
    }
  },
  "required": [
    "basics"
  ],
  "title": "MasterCV",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "master_cv_schema.json"
}
