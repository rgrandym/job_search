# Copy to .env and fill in. Never commit .env.
# Provider, models and effort are chosen in the app (Settings) and saved to
# data/llm_config.json; the match threshold is the sidebar slider. They are not set here.
ANTHROPIC_API_KEY=
# Job sources
JOBSEARCH_REED_API_KEY=
JOBSEARCH_CV_LIBRARY_API_KEY=
JOBSEARCH_ADZUNA_APP_ID=
JOBSEARCH_ADZUNA_APP_KEY=
# Dedicated Gmail inbox for manual job-alert searches (Google OAuth Web application)
JOBSEARCH_GMAIL_ACCOUNT=
JOBSEARCH_GMAIL_CLIENT_ID=
JOBSEARCH_GMAIL_CLIENT_SECRET=
# Defaults: http://localhost:8000/api/gmail/callback and http://localhost:5173/
# JOBSEARCH_GMAIL_REDIRECT_URI=
# JOBSEARCH_GMAIL_FRONTEND_URL=
JOBSEARCH_HTTP_USER_AGENT="ai-job-search/0.1 (you@example.com)"
# LinkedIn public job search: seconds between requests, result pages per title, and how many
# shortlisted postings are opened for the full text per search.
# JOBSEARCH_LINKEDIN_DELAY_S=2.5
# JOBSEARCH_LINKEDIN_MAX_PAGES=3
# JOBSEARCH_LINKEDIN_MAX_DETAILS=60
